# Online providers. Keep real keys out of git.
# Gemini on Vertex, for the open-vocabulary extractor. Service-account key at VERTEX_CREDENTIALS.
VERTEX_PROJECT=
CLINICAL_LLM_PROVIDER=ollama
SARVAM_API_KEY=

# Runtime
DEPLOYMENT_PROFILE=online
SARVAM_STT_LANGUAGE=auto
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=shubh
SESSION_STORE_PATH=data/medikiosk.db
# Generate with: python -m medikiosk.keygen
SESSION_ENCRYPTION_KEY=
